# Copy this file to .env and adjust as needed. All values have working
# defaults in app/config.py, so .env is optional for local development.

# Path to trained PPE weights. Falls back to a pretrained COCO
# checkpoint (person-only detection) if this file does not exist yet.
MODEL_WEIGHTS_PATH=models/best.pt
FALLBACK_WEIGHTS=yolov8n.pt

CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
DEVICE=cpu

REQUIRED_GEAR=helmet,safety_vest,safety_glasses
GEAR_MATCH_OVERLAP=0.3

ALERTS_DIR=alerts
UPLOADS_DIR=uploads
DB_PATH=storage/violations.db

CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

VIDEO_FRAME_SAMPLE_RATE=5
MAX_VIDEO_FRAMES=600

# Required only by scripts/download_dataset.py when using Roboflow.
ROBOFLOW_API_KEY=
